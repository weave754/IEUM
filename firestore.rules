rules_version = '2';
// WEAVE 업무도우미 Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 통째로 붙여 넣고 '게시'를 눌러요.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function orgPath(cid) { return /databases/$(database)/documents/org/$(cid); }
    function isAdmin(cid) {
      return signedIn() && exists(orgPath(cid)) && request.auth.uid in get(orgPath(cid)).data.admins;
    }
    function isMember(cid) {
      return signedIn() && (isAdmin(cid) || exists(/databases/$(database)/documents/org/$(cid)/members/$(request.auth.uid)));
    }

    // 내 기록(할 일, 경험치, 내 매뉴얼, 회사 목록): 나만 읽고 써요.
    match /data/users/{uid}/{rest=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 회사 코드 → 회사 번호. 코드를 아는 사람만 하나씩 열어 볼 수 있어요(목록은 못 봐요).
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if isAdmin(request.resource.data.cid);
      allow delete: if isAdmin(resource.data.cid);
    }

    // 회사
    match /org/{cid} {
      allow get: if isMember(cid);
      allow list: if signedIn() && request.auth.uid in resource.data.admins;
      allow create: if signedIn() && request.resource.data.admins == [request.auth.uid];
      allow update: if isAdmin(cid);

      // 직원 명단과 진행 상황: 직원은 자기 것만, 관리자는 모두 봐요.
      match /members/{uid} {
        allow read: if isAdmin(cid) || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid
                      && request.resource.data.code == get(orgPath(cid)).data.code;
        allow update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.code == resource.data.code;
        allow delete: if isAdmin(cid) || (signedIn() && request.auth.uid == uid);
      }

      // 할 일, 절차, 지침, 회의: 회사 사람은 읽고, 관리자만 써요.
      match /{coll}/{id} {
        allow read: if coll != 'members' && isMember(cid);
        allow write: if coll != 'members' && isAdmin(cid);
      }
    }
  }
}
